<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.85" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\D2.Data\D2.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="golden/**" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../corpus/sample/**" Link="corpus/sample/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../data/ui/**" Link="data/ui/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../data/video/**" Link="data/video/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../data/game/**" Link="data/game/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../data/gfx/**" Link="data/gfx/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../data/map/**" Link="data/map/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../data/rules/**" Link="data/rules/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../data/scenarios/**" Link="data/scenarios/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../data/sound/**" Link="data/sound/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../data/music/**" Link="data/music/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- Пример мода (mods/) кладётся рядом с data/ целиком, с подкаталогами: GameContentTests проверяет
         наложение на тех же файлах, что читает игра. -->
    <None Include="../../mods/**" Link="mods/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
